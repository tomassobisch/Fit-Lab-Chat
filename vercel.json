{
  "version": 2,
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-digest",
      "schedule": "0 7 * * *"
    }
  ],
  "functions": {
    "api/render.ts": {
      "includeFiles": "api/_assets/**"
    }
  }
}
